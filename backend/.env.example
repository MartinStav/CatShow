# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Postgres
#--------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB_NAME=catshow

#--------------------------------------------------------------------
# CORS — comma-separated allowlist used in production.
# In development every origin is reflected automatically.
#--------------------------------------------------------------------
# CORS_ORIGINS=https://catshow.example.com,https://admin.catshow.example.com

#--------------------------------------------------------------------
# Web Push notifications (for exhibitor status updates)
# Generate VAPID keys once (example):
#   npx web-push generate-vapid-keys
#--------------------------------------------------------------------
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=