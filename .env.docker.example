# Docker compose environment.
# Copy to `.env` next to docker-compose.yml: `cp .env.docker.example .env`.

# --- Public ---
FRONTEND_PORT=8080
TZ=UTC

# --- App ---
# Vygeneruj raz, napríklad: openssl rand -base64 32
APP_KEY=replace-me-with-a-random-32-byte-secret
APP_URL=http://localhost:8080

# Allowlist originov pre CORS (čiarkou oddelený zoznam).
# Pri jednoduchom nasadení (frontend + backend cez to isté nginx) môžeš nechať prázdne.
CORS_ORIGINS=

LOG_LEVEL=info
SESSION_DRIVER=cookie

# --- Postgres ---
POSTGRES_USER=catshow
POSTGRES_PASSWORD=catshow
POSTGRES_DB=catshow

# --- Seed superadmina pri prvom štarte ---
RUN_SEEDS=true
# SEED_SUPERADMIN_EMAIL=admin@catshow.sk
# SEED_SUPERADMIN_FORCE_RESET=false

# --- Web push (voliteľné) ---
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
